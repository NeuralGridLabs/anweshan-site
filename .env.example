# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it is the thing a new machine or a new teammate starts from.
#
#   cp .env.example .env.local
#
# Build-time configuration. The build prerenders every page from Sanity and
# THROWS if NEXT_PUBLIC_SANITY_PROJECT_ID is missing rather than shipping an
# empty site, so all three NEXT_PUBLIC_ vars below must be present wherever
# `npm run build` runs.
# ---------------------------------------------------------------------------

# The site's public origin, with no trailing path: https://www.anweshan.org
#
# Used for every canonical URL, og:url, the sitemap and robots.txt. Set this in
# the hosting dashboard for the production context - https://www.anweshan.org -
# and it is fine for it to be the only one that has it.
#
# A production build with this unset does NOT fail and does NOT emit
# http://localhost:3000: src/lib/seo.ts falls back to the hard-coded
# PRODUCTION_SITE_URL (https://www.anweshan.org). Setting the variable is still
# correct, because then the origin lives in one configurable place.
#
# Leave it UNSET locally - the dev server falls back to http://localhost:3000 on
# its own, and robots.txt then disallows everything so a dev build is never
# crawled.
NEXT_PUBLIC_SITE_URL=

# Optional. Set to exactly "true" to take a live deploy out of search indexes
# without undeploying it. Only the lowercase string "true" blocks; "TRUE", "1"
# and "yes" are ignored on purpose. Unset in production.
BLOCK_INDEXING=

# Sanity project ID. The only variable with no usable default - without it the
# build fails. Public by design: it appears in browser bundles.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name. Defaults to "production" if unset.
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version, pinned so query semantics cannot shift under you.
# Defaults to "2024-01-01" if unset.
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Read token. Only needed if the dataset is NOT publicly readable. Used
# server-side only; never exposed to the browser.
SANITY_API_READ_TOKEN=

# Write token. Needed ONLY by the one-off import scripts in scripts/*.mjs.
# No npm script and no build step touches it - if you are just running the
# site you can leave this empty.
SANITY_API_WRITE_TOKEN=